# ==============================================================================
# SMART CLINIC OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production on production server
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://clinic.smartclinic.in

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourSecureProductionPostgresPasswordHere_2026
DB_NAME=smart_clinic_os
DATABASE_URL=postgresql://postgres:YourSecureProductionPostgresPasswordHere_2026@postgres:5432/smart_clinic_os
DB_POOL_MAX=30

# Redis Cache & PubSub
REDIS_URL=redis://:YourSecureRedisPasswordHere_2026@redis:6379
REDIS_PASSWORD=YourSecureRedisPasswordHere_2026

# JWT & Cryptographic Signing Keys
JWT_SECRET=super_secret_jwt_hmac_sha256_minimum_64_characters_long_for_security_2026
JWT_EXPIRATION=7d
TELECONSULTATION_HMAC_SECRET=super_secret_teleconsultation_room_hmac_token_key_2026

# Storage Paths
STORAGE_DIR=/app/server/storage

# Razorpay Production Credentials
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_signature_secret

# ABDM National Health Authority (NHA) Production Credentials
ABDM_ENV=sandbox
ABDM_SANDBOX_URL=https://dev.abdm.gov.in/gateway/v0.5
ABDM_CLIENT_ID=your_registered_abdm_client_id
ABDM_CLIENT_SECRET=your_registered_abdm_client_secret

# Diagnostic Laboratory Webhook Secrets
METROPOLIS_WEBHOOK_SECRET=metropolis_production_webhook_secret_2026
LALPATH_WEBHOOK_SECRET=lalpath_production_webhook_secret_2026

# Pharmacy Integration API Keys
APOLLO_API_KEY=apollo_pharmacy_production_api_key_2026
MEDPLUS_API_KEY=medplus_pharmacy_production_api_key_2026

# Google Maps API Key for Traffic Intelligence
GOOGLE_MAPS_API_KEY=AIzaSyYourActualGoogleMapsTrafficMatrixApiKeyHere

