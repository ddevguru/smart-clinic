# ==============================================================================
# SMART CLINIC OS — PRODUCTION BACKEND DOCKERFILE
# Node.js 22 Alpine Multi-Stage Production Image
# ==============================================================================

FROM node:22-alpine AS dependencies
WORKDIR /app

# Install native compilation dependencies for cryptographic/PDF bindings
RUN apk add --no-cache python3 make g++

COPY server/package.json ./
RUN npm install --omit=dev --ignore-scripts && npm rebuild

# ------------------------------------------------------------------------------
# Production Runner Stage
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Security: Run as unprivileged non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 smartclinic

# Create storage directory for prescriptions, receipts, and clinical uploads
RUN mkdir -p /app/server/storage && \
    chown -R smartclinic:nodejs /app/server/storage

COPY --from=dependencies /app/node_modules ./server/node_modules
COPY server/ ./server/

USER smartclinic

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/v1/health || exit 1

CMD ["node", "server/src/server.js"]

